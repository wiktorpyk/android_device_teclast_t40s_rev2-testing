	odm {
		compatible = "simple-bus";
		phandle = <0xcc>;

		led@0 {
			compatible = "mediatek,red";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11a>;
		};

		led@1 {
			compatible = "mediatek,green";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11b>;
		};

		led@2 {
			compatible = "mediatek,blue";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11c>;
		};

		led@3 {
			compatible = "mediatek,jogball-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11d>;
		};

		led@4 {
			compatible = "mediatek,keyboard-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11e>;
		};

		led@5 {
			compatible = "mediatek,button-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x11f>;
		};

		led@6 {
			compatible = "mediatek,lcd-backlight";
			led_mode = <0x05>;
			data = <0x01>;
			pwm_config = <0x00 0x01 0x00 0x00 0x00>;
			phandle = <0x120>;
		};

		vibrator@0 {
			compatible = "mediatek,vibrator";
			vib_timer = <0x19>;
			vib_limit = <0x09>;
			vib_vol = <0x09>;
			phandle = <0x121>;
		};

		panel@0 {
			compatible = "es,es6311_anx6585_zigzag_wxga";
			gpio_lcd_pwr_en = <0x1e 0x9e 0x00>;
			lcd_rst_pin = <0x1e 0x2d 0x00>;
			status = "okay";
			phandle = <0x122>;
		};

		mt_pmic_customization@0 {
			compatible = "mediatek,mt-pmic-custom-setting";
			custom-reg = <0x1c32 0x01 0x07 0x00 0x18ba 0x01 0x01 0x00>;
			disable-modem = <0x01>;
			phandle = <0x123>;
		};
	};

